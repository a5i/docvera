{
  "name": "@a5i/docvera",
  "version": "0.1.1",
  "description": "Native Node.js bindings for docvera, a schema-validated, indexed and queryable Markdown knowledge engine",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/a5i/docvera",
    "directory": "npm/docvera"
  },
  "files": ["index.js", "index.d.ts", "platforms.cjs", "docvera.*.node", "LICENSE"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node build.cjs",
    "build:release": "node build.cjs --release",
    "validate:release": "node scripts/validate-release.cjs",
    "test": "node --test test/*.test.cjs"
  }
}
